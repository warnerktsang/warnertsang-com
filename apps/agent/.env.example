# ---- Database ----
# PostgreSQL connection string. Local dev (see README for docker command):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/agent?schema=public"

# ---- Auth (Auth.js / NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app. Local: http://localhost:3000
# On Vercel this is set automatically; only override for a custom domain.
AUTH_URL="http://localhost:3000"

# ---- Google OAuth (sign-in + Calendar read-only) ----
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Access control ----
# Only this Google account may sign in. Enforced server-side (fail closed).
ALLOWED_GOOGLE_EMAIL="you@example.com"

# ---- MCP server auth ----
# Optional shared bearer token for the remote MCP endpoint.
MCP_BEARER_TOKEN="replace-with-a-shared-token"

# ---- Plaid / finance ingestion ----
PLAID_ENV="production"
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# Generate with: openssl rand -hex 32
FINANCE_ENCRYPTION_KEY=""
