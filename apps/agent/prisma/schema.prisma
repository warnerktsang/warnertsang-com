// Personal Agent OS — Phase 1 schema.
// Intentionally simple but extensible: future connectors and agent runtimes
// reuse the same users / threads / tool_calls / audit_events tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts      OAuthAccount[]
  threads            ChatThread[]
  toolCalls          ToolCall[]
  auditEvents        AuditEvent[]
  financeConnections FinanceConnection[]
  financeSyncRuns    FinanceSyncRun[]

  @@map("users")
}

// OAuth account linkage + token storage.
// NOTE (Phase 2): access/refresh tokens are stored in plaintext for the MVP.
// All reads/writes go through the TokenStore abstraction so this can be swapped
// for an encrypted store (e.g. KMS envelope encryption) without touching callers.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int? // epoch seconds
  tokenType         String?
  scope             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

// Declarative record of connectors known to the platform. Seeded from the
// in-code ConnectorRegistry; runtime "connected" state is derived from the
// user's OAuth scopes.
model Connector {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String
  provider    String
  scopes      String[]
  status      String   @default("available")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("connectors")
}

model ChatThread {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_threads")
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String // user | assistant | system
  content   String // flattened text for quick rendering / search
  parts     Json? // full UIMessage parts (tool calls, etc.) for fidelity
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("chat_messages")
}

// One row per tool invocation attempt (running -> success | error).
model ToolCall {
  id          String    @id @default(cuid())
  userId      String
  threadId    String?
  connector   String
  tool        String
  status      String // running | success | error
  input       Json?
  output      Json?
  error       String?
  durationMs  Int?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("tool_calls")
}

// Append-only audit trail. Never store tokens/secrets in `metadata`.
model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String // login | login_denied | connector_access | tool_execution | error
  action    String
  connector String?
  tool      String?
  success   Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_events")
}

model FinanceConnection {
  id                   String    @id @default(cuid())
  userId               String
  provider             String
  itemId               String
  encryptedAccessToken String
  institutionId        String?
  institutionName      String?
  status               String    @default("connected")
  lastSyncedAt         DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts FinanceAccount[]
  syncRuns FinanceSyncRun[]

  @@unique([userId, provider])
  @@unique([provider, itemId])
  @@index([userId])
  @@map("finance_connections")
}

model FinanceAccount {
  id                String   @id @default(cuid())
  connectionId      String
  providerAccountId String
  name              String
  officialName      String?
  mask              String?
  type              String
  subtype           String?
  isoCurrencyCode   String?
  currentBalance    Decimal?
  availableBalance  Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connection   FinanceConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([connectionId, providerAccountId])
  @@index([connectionId])
  @@map("finance_accounts")
}

model FinanceTransaction {
  id                    String    @id @default(cuid())
  accountId             String
  providerTransactionId String
  pendingTransactionId  String?
  name                  String
  merchantName          String?
  originalDescription   String?
  amount                Decimal
  isoCurrencyCode       String?
  postedAt              DateTime
  authorizedAt          DateTime?
  pending               Boolean   @default(false)
  paymentChannel        String?
  category              String[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerTransactionId])
  @@index([accountId, postedAt])
  @@index([postedAt])
  @@map("finance_transactions")
}

model FinanceSyncRun {
  id                String    @id @default(cuid())
  userId            String
  connectionId      String
  provider          String
  requestedStart    DateTime
  requestedEnd      DateTime
  status            String    @default("running")
  transactionsSeen  Int       @default(0)
  transactionsSaved Int       @default(0)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  error             String?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection FinanceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([connectionId, startedAt])
  @@map("finance_sync_runs")
}
